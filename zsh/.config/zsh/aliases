alias rmmac_garbage='find . -type f -name ".DS_Store" -delete && find . -type d -name "__MACOSX" -delete'

# Get core of VS Code problems JSON for AI from clipboard
# I.e., copy from Problems panel for a specific file
# output:
# @/file/path
# {
#   "message": "something",
#   "startLineNumber": 95
# }
alias codeproblems='pbpaste | jq -r "([.[0].resource] | \"@\" + .[0]), (.[] | {message: .message, startLineNumber: .startLineNumber})"'

# Open in Code
oc() {
  IFS=$'\n' files=($(fzf --query="$1" --multi --select-1 --exit-0))
  [[ -n "$files" ]] && code "${files[@]}"
}

# Open in Neovim
onvim() {
  IFS=$'\n' files=($(fzf --query="$1" --multi --select-1 --exit-0))
  [[ -n "$files" ]] && ${EDITOR:-vim} "${files[@]}"
}

# Open in Vim
ovim() {
  IFS=$'\n' files=($(fzf --query="$1" --multi --select-1 --exit-0))
  [[ -n "$files" ]] && vim "${files[@]}"
}

function killport() {
    lsof -i TCP:$1 | grep LISTEN | awk '{print $2}' | while read pid; do
        echo "Killing process with PID $pid listening on port $1"
        kill -9 "$pid"
    done
}
